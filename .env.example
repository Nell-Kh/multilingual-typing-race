# Copy to .env and fill in. Never commit .env.
# Only variables that exist at the current milestone are listed; more are added per milestone.

# --- app (backend/app/core/settings.py) ---
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- auth ---
# Any string of 32+ characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in prod; dev and tests fall back to a built-in throwaway value.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Rate limiting on /auth (ADR-022). The defaults below are the ones in the code;
# every line is optional, and raising a ceiling needs no code change.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=900
# RATE_LIMIT_REGISTER_PER_IP=20
# RATE_LIMIT_LOGIN_PER_IP=40
# RATE_LIMIT_LOGIN_FAILURES_PER_EMAIL=10
# RATE_LIMIT_REFRESH_PER_IP=120

# --- database (asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://typing:typing@localhost:5432/typing

# --- redis ---
REDIS_URL=redis://localhost:6379/0

# --- docker-compose only (used to init the postgres container) ---
POSTGRES_USER=typing
POSTGRES_PASSWORD=typing
POSTGRES_DB=typing

# --- frontend (Vite only exposes VITE_* to the browser) ---
VITE_API_URL=http://localhost:8000
