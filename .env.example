# Copy to .env and fill in. Never commit .env.
# Only variables that exist at the current milestone are listed; more are added per milestone.

# --- app (backend/app/core/settings.py) ---
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- database (asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://typing:typing@localhost:5432/typing

# --- redis ---
REDIS_URL=redis://localhost:6379/0

# --- docker-compose only (used to init the postgres container) ---
POSTGRES_USER=typing
POSTGRES_PASSWORD=typing
POSTGRES_DB=typing

# --- frontend (Vite only exposes VITE_* to the browser) ---
VITE_API_URL=http://localhost:8000
